{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom site-footer mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      <div class="footer-top">
        <div class="footer-brand">
          <span class="brand-mark" aria-hidden="true">
            {{- site.first_name | slice: 0 -}}
            {{- site.last_name | slice: 0 -}}
          </span>
          <div>
            <span class="footer-name">
              {{- site.first_name }}
              {{ site.last_name -}}
            </span>
            <span class="footer-role">{{ site.footer_role }}</span>
          </div>
        </div>
        <div class="footer-social">{% include social.liquid %}</div>
      </div>
      <div class="footer-bottom">{{ footer_contents }}</div>
    </div>
  </footer>
{% endif %}
